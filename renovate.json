{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>nklmilojevic/renovate-config",
    "helpers:pinGitHubActionDigests"
  ],
  "packageRules": [
    {
      "description": "Workflows hold the release signing keys: their updates are reviewed, never merged automatically.",
      "matchFileNames": [
        ".github/workflows/**"
      ],
      "automerge": false
    }
  ]
}
