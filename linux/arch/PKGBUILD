# Maintainer: Nikola Milojević <nikola at milojevic dot me>
#
# Thurm for Arch Linux (and CachyOS, EndeavourOS, Manjaro): the GTK app, thurmd and thurm.
# Published to the AUR by scripts/linux/aur-update.sh; scripts/linux/arch-package.sh builds it
# from a working tree instead of the release tarball.
pkgname=thurm
pkgver=0.2.2
pkgrel=1
pkgdesc="Terminal for persistent sessions, coding agents and remote work"
arch=(x86_64 aarch64)
url="https://thurm.rs"
license=(Apache-2.0)
depends=(gtk4 libadwaita fontconfig hicolor-icon-theme)
makedepends=(rustup zig git musl pkgconf curl python)
optdepends=('openssh: remote workspaces'
            'git: handing work off to remote agents'
            'noto-fonts-cjk: Chinese, Japanese and Korean text'
            'noto-fonts-emoji: colour emoji')
options=(!lto !debug)
source=("thurm-$pkgver.tar.gz::https://github.com/nklmilojevic/thurm/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

_env() {
    export CARGO_TARGET_DIR="$srcdir/target"
    export ZIG_GLOBAL_CACHE_DIR="$srcdir/zig-cache"
    # The app and daemon must carry the same build id (an app that finds another build
    # replaces the running daemon in place).
    export THURM_BUILD="$pkgver+arch.$pkgrel"
}

prepare() {
    _env
    cd "thurm-$pkgver"
    # The toolchain rust-toolchain.toml pins, with the target of the static thurm and thurmd.
    rustup toolchain install
    rustup target add "$CARCH-unknown-linux-musl"
    # Ghostty's Zig packages, fetched with curl (Zig's own client stalls on some networks).
    scripts/linux/zig-prefetch.sh
    cargo fetch --locked
}

build() {
    _env
    cd "thurm-$pkgver"
    cargo build --release --frozen -p thurm-gtk
    # thurm and thurmd static, like the release's Linux builds: the app copies them onto
    # remote hosts.
    cargo build --release --frozen --target "$CARCH-unknown-linux-musl" -p thurm-daemon -p thurm-cli
    python3 scripts/third-party-licenses.py
}

check() {
    _env
    cd "thurm-$pkgver"
    cargo test --release --frozen -p thurm-gtk
}

package() {
    cd "thurm-$pkgver"
    install -Dm755 "$srcdir/target/release/thurm-gtk" "$pkgdir/usr/bin/thurm-gtk"
    install -Dm755 "$srcdir/target/$CARCH-unknown-linux-musl/release/thurmd" "$pkgdir/usr/bin/thurmd"
    install -Dm755 "$srcdir/target/$CARCH-unknown-linux-musl/release/thurm" "$pkgdir/usr/bin/thurm"
    install -Dm644 linux/rs.thurm.Thurm.desktop "$pkgdir/usr/share/applications/rs.thurm.Thurm.desktop"
    install -Dm644 linux/rs.thurm.Thurm.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/rs.thurm.Thurm.png"
    install -Dm644 -t "$pkgdir/usr/share/thurm/fonts" macos/Resources/fonts/*.ttf
    install -Dm644 -t "$pkgdir/usr/share/thurm/icons/hicolor/scalable/actions" \
        linux/icons/hicolor/scalable/actions/*.svg
    install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE THIRD_PARTY_LICENSES \
        macos/Resources/fonts/JetBrainsMono-OFL.txt macos/Resources/fonts/SymbolsNerdFont-LICENSE \
        licenses/ghostty-MIT.txt
    install -Dm644 linux/icons/COPYING "$pkgdir/usr/share/licenses/$pkgname/adwaita-icons-COPYING"
    mkdir -p "$pkgdir/usr/share/thurm/skills"
    cp -R skills/thurm "$pkgdir/usr/share/thurm/skills/"
    chmod -R u=rwX,go=rX "$pkgdir/usr/share/thurm/skills"
}
