use flake

# The dev shell's gh shadows a sefko-wrapped gh, so with sefko wrap it the same way.
if has sefko; then
  mkdir -p .direnv/bin
  printf '#!/bin/sh\nexec %s wrap github --bypass GITHUB_TOKEN -- %s "$@"\n' \
    "$(command -v sefko)" "$(command -v gh)" > .direnv/bin/gh
  chmod +x .direnv/bin/gh
  PATH_add .direnv/bin
fi
